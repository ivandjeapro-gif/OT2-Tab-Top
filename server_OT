  const derniere = sh.getLastRow() > 1 ? parseInt(String(sh.getRange(sh.getLastRow(), 1).getValue()), 10) || 0 : 0;
  const id = derniere + 1;
  sh.appendRow([id, profil, message, maintenant()]);
  return corps(true, { id: id, profil: profil, message: message });
}

