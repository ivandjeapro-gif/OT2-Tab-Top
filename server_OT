/**
 * Ouvre le dossier des plans et rend le Folder, ou leve une erreur explicite.
 *
 * Le point sensible : un dossier partage A UNE ADRESSE donnee est lisible en
 * HTTP, mais DriveApp exige que le compte qui execute le script figure parmi
 * les personnes autorisees (ou que le partage soit public). D'ou de vrais
 * messages au lieu d'un catch muet.
 */
function ouvrirDossierPlans() {
  return DriveApp.getFolderById(CONFIG.DOSSIER_PLANS_ID);
}

/** Vrai si le nom correspond a un fichier image exploitable comme plan. */
function estFichierPlan(nom) {
  return /\.(jpe?g|png|gif|webp|bmp)$/i.test(String(nom || ''));
}

/** Code de carte deduit du nom de fichier (sans extension ni prefixe plan_). */
function codeCarteDepuisNom(nom) {
  let n = String(nom || '').trim();
  const point = n.lastIndexOf('.');
  if (point > 0) n = n.substring(0, point);
  if (n.toLowerCase().indexOf('plan_') === 0) n = n.substring(5);
  return n.trim();
}

/**
 * GET ?action=plans : liste EXHAUSTIVE du dossier.
 *
 * Reponse : { ok:true, dossier:<id>, nombre:<n>,
 *             plans:[{carte, id, nom, url}] }
 *
 * ok:false protege le poste : le client ne supprime rien et ne telecharge
 * rien quand l'inventaire n'est pas sur. Une liste VIDE, au contraire, est
 * une information : le dossier est vide, la tablette purge ses plans.
 */
function plansInventaire() {
  let dossier;
  try {
    dossier = ouvrirDossierPlans();
  } catch (e) {
    return corps(false,
      'dossier plans inaccessible : ' + (e && e.message ? e.message : e) +
      ' - partagez le dossier avec l\'adresse qui execute la Web App ' +
      '(au moins Lecteur), ou avec toute personne disposant du lien');
  }
  const plans = [];
  try {
    const fichiers = dossier.getFiles();
    while (fichiers.hasNext()) {
      const f = fichiers.next();
      const nom = f.getName();
      if (!estFichierPlan(nom)) continue;
      const id = f.getId();
      plans.push({
        carte: codeCarteDepuisNom(nom),
        id: id,
        nom: nom,
        url: 'https://drive.google.com/uc?export=download&confirm=t&id=' + id,
      });
    }
  } catch (e) {
    return corps(false,
      'lecture du dossier plans impossible : ' + (e && e.message ? e.message : e));
  }
  // Tri stable : deux appels successifs rendent le meme ordre, les journaux
  // et les diffs restent comparables.
  plans.sort((a, b) => (a.carte < b.carte ? -1 : (a.carte > b.carte ? 1 : 0)));
  return corps(true, {
    dossier: dossier.getId(),
    nombre: plans.length,
    plans: plans,
  });
}

/**
 * Etat lisible du dossier des plans, pour l'action sante.
 * Ex. "OK (12 fichier(s))" ou "INACCESSIBLE : <motif>".
 */
function etatDossierPlans() {
  let dossier;
  try {
    dossier = ouvrirDossierPlans();
  } catch (e) {
    return 'INACCESSIBLE : ' + (e && e.message ? e.message : e);
  }
  let n = 0;
  const fichiers = dossier.getFiles();
  while (fichiers.hasNext()) {
    if (estFichierPlan(fichiers.next().getName())) n++;
  }
  return 'OK (' + n + ' fichier(s))';
}

/**
 * A executer UNE FOIS depuis l'editeur Apps Script (bouton Executer, puis
 * menu Journal) : dit en clair qui execute, qui possede le dossier, quels
 * sont ses droits de partage et quels fichiers y sont.
 */
function diagnosticDossierPlans() {
  const lignes = [];
  try {
    lignes.push('Compte executant : ' + Session.getEffectiveUser().getEmail());
  } catch (e) {
    lignes.push('Compte executant : (inconnu)');
  }
  let dossier;
  try {
    dossier = ouvrirDossierPlans();
  } catch (e) {
    lignes.push('OUVERTURE : ECHEC');
    lignes.push('  motif : ' + (e && e.message ? e.message : e));
    lignes.push('  a faire : partager le dossier avec le compte ci-dessus ' +
      '(Lecteur minimum), ou avec toute personne disposant du lien');
    Logger.log(lignes.join('\n'));
    return lignes.join('\n');
  }
  lignes.push('OUVERTURE : OK');
  lignes.push('  nom     : ' + dossier.getName());
  lignes.push('  id      : ' + dossier.getId());
  try { lignes.push('  proprio : ' + dossier.getOwner().getEmail()); }
  catch (e) { lignes.push('  proprio : (non lisible)'); }
  try {
    lignes.push('  partage : ' + dossier.getSharingAccess() +
      ' / ' + dossier.getSharingPermission());
  } catch (e) { lignes.push('  partage : (non lisible)'); }
  const fichiers = dossier.getFiles();
  let n = 0;
  const exemples = [];
  while (fichiers.hasNext()) {
    const f = fichiers.next();
    if (!estFichierPlan(f.getName())) continue;
    if (exemples.length < 10) {
      exemples.push('  - ' + f.getName() + '  [' + f.getId() + ']');
    }
    n++;
  }
  lignes.push('PLANS : ' + n);
  Array.prototype.push.apply(lignes, exemples);
  Logger.log(lignes.join('\n'));
  return lignes.join('\n');
}

/**
 * URL de telechargement direct d'un plan, ou '' s'il est absent du dossier.
 * Conserve l'ancien nom urlPlanDrive : d'autres routes s'appuient dessus.
 */
function urlPlanDrive(carte) {
  if (!carte) return '';
  try {
    const fichiers = DriveApp.getFolderById(CONFIG.DOSSIER_PLANS_ID).getFiles();
    while (fichiers.hasNext()) {
      const f = fichiers.next();
      const nom = f.getName();
      const point = nom.lastIndexOf('.');
      const base = point > 0 ? nom.substring(0, point) : nom;
      if (base !== carte) continue;
      // Le fichier doit etre partage Â« Anyone with the link Â» pour que la
      // tablette puisse le telecharger. Si l'acces est restreint, Drive
      // renvoie une page HTML a la place de l'image.
      return 'https://drive.google.com/uc?export=download&id=' + f.getId();
    }
  } catch (e) {
    journal('PLAN URL ECHEC ' + carte + ' : ' + e);
  }
  return '';
}

