/**
 * Action `diagnostic` : pourquoi les referentiels sont-ils refuses ?
 *
 * `referentielsLire` ne dit que "referentiels absents ou incoherents".
 * Ici on detaille : contenu de chaque onglet, doublons et profils sans
 * machine ou sans membre actif — de quoi corriger le Sheet sans deviner.
 */
function referentielsDiagnostic() {
  const onglets = etatsOnglets();
  const profils = lireTable(CONFIG.ONGLETS.PROFILS).map((p) => ({
    code: String(p.code || '').trim(),
    libelle: String(p.libelle || '').trim(),
    role_cdc: String(p.role_cdc || '').trim(),
    actif: p.actif === true || String(p.actif).toLowerCase() === 'true' || Number(p.actif) === 1 ? 1 : 0,
  })).filter((p) => p.code);
  const identifiants = lireTable(CONFIG.ONGLETS.IDENTIFIANTS).map((e) => ({
    profil: String(e.profil || '').trim(),
    id: String(e.id || '').trim(),
    nom: String(e.nom || '').trim(),
    actif: e.actif === true || String(e.actif).toLowerCase() === 'true' || Number(e.actif) === 1 ? 1 : 0,
  })).filter((e) => e.profil && e.id);
  const flotte = lireTable(CONFIG.ONGLETS.FLOTTE).map((d) => ({
    famille: String(d.famille || '').trim(),
    numero: String(d.numero || '').trim(),
    actif: d.actif === true || String(d.actif).toLowerCase() === 'true' || Number(d.actif) === 1 ? 1 : 0,
  })).filter((d) => d.famille && d.numero);

  const FAMILLES_DT = ['1500', '785', 'ADT'];
  const famillesProfil = (role) => String(role).trim().toUpperCase() === 'DT'
    ? FAMILLES_DT : [String(role).trim().toUpperCase()];
  // Meme regle que `referentielsLire` : le profil personne porte
  // role_cdc = 'SPOTTER' (code SPOT), pas 'SPOT'.
  const estProfilMachine = (p) => {
    const role = String(p.role_cdc || '').trim().toUpperCase();
    return role !== '' && !role.includes('SPOT');
  };
  const famillesActives = new Set(
    flotte.filter((d) => d.actif).map((d) => d.famille.toUpperCase()));

  const codes = profils.map((p) => p.code);
  const doublonsProfils = codes.filter((c, i) => codes.indexOf(c) !== i);
  const clesFlotte = flotte.map((d) => d.famille.toUpperCase() + '::' + d.numero);
  const doublonsFlotte = clesFlotte.filter((c, i) => clesFlotte.indexOf(c) !== i);
  const lecture = referentielsLire();
  // La reference de profil d'un engin (DT / EXCAVATOR) n'est pas deducible
  // de la seule famille : les pelles sont en "EX 1250", "PC 2000"...
  // `referentielsLire` resout deja ce rattachement ; on reutilise son resultat
  // plutot que de refaire une deduction approximative (qui donnait un faux
  // positif sur EXCAVATOR).
  const profilsCouverts = new Set();
  if (lecture.ok && lecture.dts) {
    for (const d of lecture.dts) {
      const role = String(d.role || '').trim().toUpperCase();
      if (role && d.actif) profilsCouverts.add(role);
    }
  }
  const sansMachine = profils.filter((p) => estProfilMachine(p) && p.actif &&
    !profilsCouverts.has(String(p.role_cdc || '').trim().toUpperCase()) &&
    !famillesProfil(p.role_cdc).some((f) => famillesActives.has(f)));
  const sansMembre = profils.filter((p) => !estProfilMachine(p) && p.actif &&
    !identifiants.some((e) => e.profil === p.code && e.actif));

  return corps(true, {
    onglets: onglets,
    profils: profils,
    identifiants: identifiants,
    flotte: flotte,
    anomalies: {
      profils_vides: profils.length === 0,
      doublons_profils: doublonsProfils,
      doublons_flotte: doublonsFlotte,
      profils_sans_machine: sansMachine.map((p) => p.code + ' (' + p.role_cdc + ')'),
      profils_sans_membre: sansMembre.map((p) => p.code),
    },
    referentiels_ok: lecture.ok === true,
    referentiels_erreur: lecture.erreur || '',
  });
}

