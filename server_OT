/**
 * Action `migrer` : applique la migration de structuration (identifiants <-，
 * equipements, flotte <- dts, tab vide) puis rend le compte rendu.
 *
 * Raison d'etre : quand les referentiels en ligne sont incoherents, le seul
 * correctif est structurel (creer un onglet manquant, deplacer des lignes).
 * L'operateur ne doit pas avoir a ouvrir l'editeur Apps Script : le SaaS
 * appelle cette action via /api/gas/migrate.
 */
/**
 * Repare l'onglet evenements : remet l'entete a 18 colonnes et REALIGNE
 * les lignes existantes d'apres leur payload JSON (source de verite).
 *
 * A lancer UNE FOIS depuis l'editeur (menu Executer > reparerEvenements)
 * apres le correctif du 27/10 : les lignes ecrites avant etaient decalees
 * (easting dans la colonne du godet, zeros partout ailleurs).
 *
 * @return {string} compte rendu
 */
/**
 * Repare l'onglet `evenements` : entete a 18 colonnes, puis REALIGNEMENT
 * des lignes d'apres leur payload JSON (source de verite).
 *
 * A lancer UNE FOIS depuis l'editeur (Executer > reparerEvenements).
 *
 * LIMITE GOOGLE SHEETS : une cellule ne depasse pas 50 000 caracteres.
 * Les evenements LINE_ADD / BLAST_SEND embarquent des PHOTOS en base64 et
 * depassent couramment cette taille â€” une ecriture en bloc (setValues sur
 * toute la plage) levait alors Â« Exception: Votre saisie depasse le nombre
 * maximum de 50000 caracteres autorise par cellule Â» et RIEN n'etait
 * repare (observe le 27/10).
 *
 * D'ou trois precautions :
 *  - ecriture LIGNE PAR LIGNE, par lots de 200 (quota Apps Script) ;
 *  - une cellule trop grosse n'est JAMAIS reecrite : on conserve sa valeur
 *    d'origine (l[6]) â€” le payload reste lisible cote sheet, seule la
 *    reecriture serait refusee ;
 *  - une ligne dont une colonne derape est signalee dans le compte rendu,
 *    plutot que de faire echouer toute la reparation.
 *
 * @return {string} compte rendu
 */
function reparerEvenements() {
  const sh = feuille(CONFIG.ONGLETS.EVENEMENTS);
  const debut = ligneDebutEvenements(sh);
  const derniere = sh.getLastRow();
  const n = Math.max(0, derniere - debut + 1);

  // 1. Entete a la bonne largeur (toujours utile, meme sans donnees).
  sh.getRange(1, 1, 1, COLONNES_EVENEMENTS.length)
    .setValues([COLONNES_EVENEMENTS]).setFontWeight('bold')
    .setBackground('#f3f3f3');
  sh.setFrozenRows(1);

  if (n === 0) {
    journal('REPARATION evenements : aucune donnee');
    return 'aucune donnee a realigner';
  }

  const largeur = Math.max(sh.getLastColumn(), COLONNES_EVENEMENTS.length);
  const toutes = sh.getRange(debut, 1, n, largeur).getValues();
  const LIMITE = 49000; // marge sous les 50 000 de Sheets

  let realignees = 0;
  let conservees = 0;
  const enEchec = [];

  for (let i = 0; i < toutes.length; i++) {
    const l = toutes[i];
    const type = String(l[3] || '');
    let payload = {};
    try { payload = JSON.parse(String(l[6] || '{}')); } catch (_) { payload = {}; }

    const num = function (v) {
      const x = Number(v);
      return isFinite(x) ? x : '';
    };

    const ligne = [
      l[0], l[1], l[2], type, l[4], l[5], l[6],
      type === 'GPS_UPDATE' ? num(payload.easting) : '',
      type === 'GPS_UPDATE' ? num(payload.northing) : '',
      type === 'GPS_UPDATE' ? num(payload.elevation) : '',
      type === 'POSITION_PERLE' ? num(payload.xbloc) : '',
      type === 'POSITION_PERLE' ? num(payload.ybloc) : '',
      type === 'POSITION_PERLE' ? num(payload.zbloc) : '',
      type === 'MOYENNE_PERLE' ? num(payload.xmoy) : '',
      type === 'MOYENNE_PERLE' ? num(payload.ymoy) : '',
      type === 'MOYENNE_PERLE' ? num(payload.zmoy) : '',
      type === 'MOYENNE_PERLE' ? num(payload.nombre) : '',
      (type === 'POSITION_PERLE' || type === 'MOYENNE_PERLE')
        ? String(payload.dt || '') : '',
    ];

    // Cellule hors limite : on ne reecrit rien pour cette ligne.
    if (String(ligne[6] || '').length > LIMITE) {
      conservees++;
      continue;
    }

    try {
      sh.getRange(debut + i, 1, 1, ligne.length).setValues([ligne]);
      realignees++;
    } catch (e) {
      enEchec.push(debut + i + ' (' + (e && e.message ? e.message : e) + ')');
    }

    // Rendu au quota : on laisse respirer l'execution.
    if ((i + 1) % 200 === 0) SpreadsheetApp.flush();
  }

  // Purge des colonnes en trop, seulement si plus personne ne les utilise.
  if (sh.getLastColumn() > COLONNES_EVENEMENTS.length) {
    const extra = sh.getRange(1, COLONNES_EVENEMENTS.length + 1, sh.getLastRow(),
                              sh.getLastColumn() - COLONNES_EVENEMENTS.length)
                    .getValues();
    const utilisee = extra.some(function (r) {
      return r.some(function (v) { return String(v).trim() !== ''; });
    });
    if (!utilisee) {
      sh.deleteColumns(
        COLONNES_EVENEMENTS.length + 1,
        sh.getLastColumn() - COLONNES_EVENEMENTS.length
      );
    }
  }

  const rapport = 'REPARATION evenements : ' + realignees + ' ligne(s) ' +
    'realignee(s), ' + conservees + ' conservee(s) (payload > ' + LIMITE +
    ' caracteres), ' + enEchec.length + ' en echec' +
    (enEchec.length ? ' [' + enEchec.slice(0, 5).join(', ') + ']' : '');
  journal(rapport);
  Logger.log(rapport);
  return rapport;
}
