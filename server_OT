// ============================================================
//  AMORCAGE â€” peuplement initial des onglets depuis le Drive
// ============================================================
//
//  A executer UNE FOIS a la main depuis l'editeur Apps Script, apres avoir
//  renseigne SPREADSHEET_ID, TOKEN et DOSSIER_PLANS_ID. C'est le pendant
//  Â« donnees Â» de initialiserOnglets() : celle-ci cree les onglets, celle-la
//  les remplit.
//
//  PRINCIPE : le dossier Drive est la source de verite. Chaque fichier du
//  dossier Â« Map ORE Â» porte la nomenclature du site en nom de base :
//
//      232.5_OM_LWP2_235_230_106.gif
//       |    |   |    |   |   `-- pattern
//       |    |   |    |   `------ profondeur de fin
//       |    |   |    `---------- profondeur de debut
//       |    |   `--------------- site
//       |    `------------------- activite
//       `------------------------ flitch
//
//  La fonction en derive les lignes de `cartes`, puis compose une liste de
//  blasts coherente avec `blocs`, de facon entierement deterministe : deux
//  executions produisent exactement le meme contenu, aucune donnee n'est
//  inventee au hasard.
//
//  Les numeros de blast sont attribues a partir de NUMERO_BLAST_DEBUT, dans
//  l'ordre de tri des codes de cartes. Ajustez cette constante ou la liste
//  BLASTS_AMORCE si la numerotation reelle du site differe.
// ============================================================

/** Premier numero de blast attribue par l'amorcage. */
const NUMERO_BLAST_DEBUT = 119;

/**
 * Blasts a semer : un blast = un code de carte + ses blocs.
 * Laisser `null` pour generer automatiquement 1 blast par carte du Drive,
 * avec un seul bloc. Sinon fournir la liste explicite :
 *   [{ carte: '232.5_OM_LWP2_235_230_106', numero: 119, blocs: [6, 7] }, ...]
 */
const BLASTS_AMORCE = null;

/**
 * Peuple `cartes`, `blasts` et `blocs` depuis le dossier Drive.
 * Menu Run â–¶ amorcerDepuisDrive. Le resultat est ecrit dans le journal.
 */
function amorcerDepuisDrive() {
  const rapport = amorcer();
  Logger.log(rapport);
  return rapport;
}

/**
 * Coeur de l'amorcage. Rend un compte rendu texte (testable sans journal).
 */
function amorcer() {
  const lignes = [];

  // --- 1. Inventaire du dossier Drive -----------------------------------
  const dossier = DriveApp.getFolderById(CONFIG.DOSSIER_PLANS_ID);
  const codes = [];
  const vus = {};
  const fichiers = dossier.getFiles();
  while (fichiers.hasNext()) {
    const nom = fichiers.next().getName();
    const base = baseNom(nom);
    if (!base || vus[base]) continue;
    vus[base] = true;
    codes.push(base);
  }
  codes.sort();
  if (!codes.length) {
    return 'AUCUN FICHIER dans le dossier "' + dossier.getName() +
           '" : rien a amorcer.';
  }
  lignes.push(codes.length + ' carte(s) detectee(s) dans "' +
              dossier.getName() + '".');

  // --- 2. Onglet `cartes` ------------------------------------------------
  // Un fichier dont le nom ne respecte pas la nomenclature est refuse : il
  // n'entre ni dans `cartes` ni dans les blasts, et il est signale dans le
  // rapport pour correction (renommage) plutot que decode en silence.
  const lignesCartes = [];
  const invalides = [];
  for (const code of codes) {
    const d = decoderCarte(code);
    if (!d) { invalides.push(code); continue; }
    lignesCartes.push([
      code, d.libelle, d.flitch, d.activite, d.site,
      d.profDebut, d.profFin, d.pattern,
    ]);
  }
  if (invalides.length) {
    lignes.push('REFUSES (nomenclature invalide, a renommer) : ' +
                invalides.join(', '));
  }
  if (!lignesCartes.length) {
    lignes.push('AUCUNE carte valide : amorcement annule, rien ecrit.');
    return lignes.join('\n');
  }
  ecrireTable(CONFIG.ONGLETS.CARTES, SCHEMAS.cartes, lignesCartes);
  lignes.push('cartes : ' + lignesCartes.length + ' ligne(s) ecrite(s).');

  // --- 3. Blasts et blocs -------------------------------------------------
  // La numerotation se base uniquement sur les cartes valides (lignesCartes),
  // jamais sur les fichiers refuses pour nomenclature invalide. Le numero et
  // le nombre de blocs sont extraits de la nomenclature du fichier (cf.
  // decoderCarte) : 119/120/121 n'est plus un compteur global, c'est
  // l'identifiant reellement attribue par le site (flitch -> numero).
  const blasts = BLASTS_AMORCE || lignesCartes.map((ligne) => {
    const d = decoderCarte(ligne[0]) || {};
    const nb = d.nbBlocs || 1;
    const nums = [];
    for (let i = 1; i <= nb; i++) nums.push(i);
    return {
      carte: ligne[0],
      numero: d.numero || '?',
      blocs: nums,
    };
  });

  const lignesBlasts = blasts.map((b) => [b.numero, b.carte]);
  const lignesBlocs = [];
  for (const b of blasts) {
    for (const n of (b.blocs || [])) {
      // `carte` rattache le bloc a son RL ; un blast peut couvrir plusieurs
      // cartes, mais `BLASTS_AMORCE` n'en porte qu'une par defaut.
      lignesBlocs.push([b.numero, n, b.carte]);
    }
  }
  ecrireTableOuLoge(CONFIG.ONGLETS.BLASTS, SCHEMAS.blasts, lignesBlasts, ['numero']);
  ecrireTableOuLoge(CONFIG.ONGLETS.BLOCS, SCHEMAS.blocs, lignesBlocs, ['numero']);
  ecrireTableOuLoge(CONFIG.ONGLETS.CARTES, SCHEMAS.cartes, lignesCartes, ['flitch']);
  lignes.push('blasts : ' + lignesBlasts.length + ' ligne(s).');
  lignes.push('blocs : ' + lignesBlocs.length + ' ligne(s).');

  // --- 4. Controle de coherence ------------------------------------------
  const cartesSet = {};
  for (const c of codes) { if (decoderCarte(c)) cartesSet[c] = true; }
  const orphelins = blasts.filter((b) => !cartesSet[b.carte]);
  if (orphelins.length) {
    lignes.push('ATTENTION : ' + orphelins.length +
                ' blast(s) reference(nt) une carte absente du Drive : ' +
                orphelins.map((b) => b.numero + '->' + b.carte).join(', '));
  }
  const nonUtilisees = codes.filter(
    (c) => !blasts.some((b) => b.carte === c) && decoderCarte(c));
  if (nonUtilisees.length) {
    lignes.push('INFO : ' + nonUtilisees.length +
                ' carte(s) du Drive sans blast : ' + nonUtilisees.join(', '));
  }

  // --- 5. Purge : signaler ce qui est dans le sheet mais absent du Drive ----
  // `ecrireTable` fait `sh.clear()` puis reecrit, donc a chaque appel
  // d'amocer les blasts/blocs/cartes obsoletes DISPARAISSENT physiquement.
  // On liste ici ce qui va etre supprime, pour que l'utilisateur voie
  // l'operation dans le rapport au lieu d'un blanc.
  const blastsAvant = lireTable(CONFIG.ONGLETS.BLASTS);
  const nouveauxNumeros = new Set(blasts.map((b) => String(b.numero)));
  const supprimes = blastsAvant
    .filter((b) => !nouveauxNumeros.has(String(b.numero)))
    .map((b) => b.numero + '->' + b.carte);
  if (supprimes.length) {
    lignes.push('PURGE : ' + supprimes.length +
                ' blast(s) obsolete(s) supprime(s) du sheet (absent du Drive) : ' +
                supprimes.join(', '));
  }

  lignes.push('Amorcage termine. Lancez ?action=sante pour verifier.');
  return lignes.join('\n');
}

/** Nom de base d'un fichier : Â« plan_A1.jpg Â» -> Â« plan_A1 Â». */
function baseNom(nom) {
  const s = String(nom || '').trim();
  const point = s.lastIndexOf('.');
  return point > 0 ? s.substring(0, point) : s;
}

/**
 * Valide et eclate un code de carte selon la nomenclature du site :
 *   <flitch>_<activite>_<site>_<profDebut>_<profFin>_<pattern>[_<nbBlocs>]
 * ex. 232.5_OM_LWP2_235_230_106 (ancien format, 6 segments)
 * ex. 232.5_OM_LWP2_235_230_106_4 (format etendu, 7 segments : 4 blocs/polygones)
 *
 * `nbBlocs` est **optionnel** : null sur l'ancien format, entier strictement
 * positif sur le nouveau. La nomenclature reste ascendante-compatible : un
 * ancien code a 6 segments est toujours accepte, et le caller peut alors
 * retomber sur l'onglet `blocs` du serveur comme avant.
 *
 * Rend null si le code ne respecte pas la nomenclature (le fichier est alors
 * signale dans le rapport d'amorcage au lieu d'etre accepte en silence).
 */
function decoderCarte(code) {
  const seg = String(code || '').split('_');
  if (seg.length !== 6 && seg.length !== 7) return null;
  const d = {
    flitch: seg[0], activite: seg[1], site: seg[2],
    profDebut: seg[3], profFin: seg[4], pattern: seg[5],
    nbBlocs: null,
    libelle: '',
  };
  if (!d.flitch || !d.activite || !d.site || !d.pattern) return null;
  if (!/^[0-9.]+$/.test(d.profDebut) || !/^[0-9.]+$/.test(d.profFin)) return null;
  // `nbBlocs` : 7eme segment, entier strictement positif.
  if (seg.length === 7) {
    if (!/^[0-9]+$/.test(seg[6])) return null;
    const n = parseInt(seg[6], 10);
    if (!Number.isFinite(n) || n < 1) return null;
    d.nbBlocs = n;
  }
  // `numero` derive de la nomenclature : c'est l'avant-dernier segment
  // (seg[5], le `pattern`) qui est l'identifiant du blast sur le site.
  // Ex. `232.5_OM_LWP2_235_230_106` -> numero = "106" (le pattern).
  // Le `flitch` (seg[0]) sert uniquement a designer le RL/zone ; ce n'est
  // PAS l'identifiant du blast. On conserve la chaine exacte du pattern
  // pour eviter toute collision (deux pattern distincts => deux numeros
  // distincts, sans conversion numerique parasite).
  d.numero = d.pattern;
  d.libelle = 'Blast ' + d.numero +
              ' - Flitch ' + d.flitch +
              ' - ' + d.site +
              ' - ' + d.profDebut + '/' + d.profFin +
              ' - ' + d.pattern +
              (d.nbBlocs != null ? ' (' + d.nbBlocs + ' bloc(s))' : '');
  return d;
}

/**
 * Reecrit un onglet : entete en ligne 1, puis les lignes fournies. Les
 * donnees precedentes de cet onglet sont remplacees â€” les autres onglets
 * ne sont jamais touches. Utilise par l'amorcage, jamais par le routage.
 *
 * `colonnesTexte` : noms de colonnes a forcer en format Texte brut (`@`)
 * apres l'ecriture. Necessaire pour les colonnes qui portent des chaines
 * ressemblant a des nombres (ex. `numero` = `"232.5"`, `flitch` = `"235.0"`) :
 * sans ce format, Google Sheets les convertit silencieusement en nombre
 * et tronque la decimale a l'affichage, ecrasant des blasts distincts.
 */
function ecrireTable(nom, entete, lignes, colonnesTexte) {
  // Onglet absent : on le cree (entete posee ci-dessous) au lieu de lever
  // Â« onglet manquant Â» â€” la migration dts -> flotte avait besoin de cela.
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  let sh = ss.getSheetByName(nom);
  if (!sh) sh = ss.insertSheet(nom);
  sh.clear();
  sh.getRange(1, 1, 1, entete.length).setValues([entete]).setFontWeight('bold');
  sh.setFrozenRows(1);
  if (lignes.length) {
    sh.getRange(2, 1, lignes.length, entete.length).setValues(lignes);
  }
  // Force le format Texte sur les colonnes qui DOIVENT rester des chaines
  // (meme si elles ressemblent a des nombres). On le fait apres l'ecriture
  // pour que la valeur soit deja en place, puis on verrouille son format.
  if (colonnesTexte && colonnesTexte.length) {
    for (const nomCol of colonnesTexte) {
      const idx = entete.indexOf(nomCol);
      if (idx < 0) continue;
      const col = idx + 1;
      const last = Math.max(2, sh.getLastRow());
      sh.getRange(2, col, last - 1, 1).setNumberFormat('@');
    }
  }
}

/**
 * Variante d'ecrireTable qui ne propage PAS l'exception : en cas d'echec
 * (onglet protege, permissions, etc.), on loge dans le journal et on continue,
 * pour ne JAMAIS casser l'amorcage. Le log permet de diagnostiquer pourquoi
 * un onglet n'a pas ete reecrit alors que le Drive avait bien les fichiers.
 */
function ecrireTableOuLoge(nom, entete, lignes, colonnesTexte) {
  try {
    ecrireTable(nom, entete, lignes, colonnesTexte);
  } catch (erreur) {
    journal('ECRITURE ECHEC onglet "' + nom + '" : ' + String(erreur));
    throw erreur;
  }
}

