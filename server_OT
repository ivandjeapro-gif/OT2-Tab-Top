function notificationEcrire(brut) {
  let p = {};
  try { p = JSON.parse(brut || '{}'); } catch (err) { /* corps vide */ }
  const profil = String(p.profil || '').trim();
  const message = String(p.message || '').trim();
  if (!message) throw 'message absent';
  const sh = feuille(CONFIG.ONGLETS.NOTIFICATIONS);
