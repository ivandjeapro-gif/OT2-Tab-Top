/**
 * Repond 200 (ok:true) avec l'affectation, ou affectation vide si aucune
 * mission (equivalent 404 du CDC : le client n'ecrit rien).
 * Le parcours est renvoye A CHAQUE APPEL (regle Â§4.4) : il vient du cache
 * s'il est frais, sinon il est recalcule depuis la position connue du DT.
 */
function affectationLire() {
  const brut = lireCleValeur(CONFIG.ONGLETS.AFFECTATION);
  if (Object.keys(brut).length === 0) {
    return corps(true, { affectation: {}, valide_le: '' });
  }

  const mission = {
    destination: brut.destination ? String(brut.destination) : '',
    dumping_area: brut.dumping_area ? String(brut.dumping_area) : '',
    mission: brut.mission ? String(brut.mission) : '',
    alerte: brut.alerte ? String(brut.alerte) : '',
  };

  // Recalcul du parcours : destination changee OU cache expire.
  const cache = cacheParcours();
  const cible = mission.destination + '|' + mission.dumping_area;
  if (!cache || cache.cle !== cible || expireParcours(cache.horodatage)) {
    const points = calculerParcours(mission.dumping_area);
    if (points && points.length >= 2) {
      mission.parcours = JSON.stringify(points);
      poserCacheParcours(cible, mission.parcours);
      // Persiste : une coupure Apps Script ne doit pas perdre le trajet.
      ecrireValeurAffectation('parcours', mission.parcours);
    } else if (brut.parcours) {
      // Recalcul impossible (pistes absentes, point inconnu) : le dernier
      // trajet valide reste servi, une erreur ne doit jamais vider la mission.
      mission.parcours = String(brut.parcours);
    }
  } else {
    mission.parcours = cache.parcours;
  }

  return corps(true, { affectation: mission, valide_le: String(brut.valide_le || '') });
}

/** Ecrit une cle d'affectation sans ecraser les autres (parcours persiste). */
function ecrireValeurAffectation(cle, valeur) {
  const sh = feuille(CONFIG.ONGLETS.AFFECTATION);
  const valeurs = sh.getDataRange().getValues();
  for (let i = 0; i < valeurs.length; i++) {
    if (valeurs[i][0] === cle) {
      sh.getRange(i + 1, 2).setValue(valeur);
      return;
    }
  }
  sh.appendRow([cle, valeur]);
}

// ============================================================
//  PARCOURS â€” plus court chemin vers la dumping area (CDC Â§4.5)
// ============================================================

function cacheParcours() {
  const brut = PropertiesService.getScriptProperties()
    .getProperty('cache_parcours');
  return brut ? JSON.parse(brut) : null;
}

function poserCacheParcours(cle, parcours) {
  PropertiesService.getScriptProperties().setProperty('cache_parcours', JSON.stringify({
    cle: cle,
    parcours: parcours,
    horodatage: Date.now(),
  }));
}

function expireParcours(horodatage) {
  return Date.now() - horodatage > CONFIG.CACHE_PARCOURS_S * 1000;
}

/**
 * Dijkstra sur le graphe des pistes (LineStrings nommees du GeoJSON), du
 * depot vers la dumping area demandee. Resultat en UTM metres, >= 2 points.
 * Rend null si la geometrie n'est pas disponible : l'affectation garde
 * alors son dernier parcours valide.
 */
function calculerParcours(dumpingArea) {
  try {
    const geo = DriveApp.getFileById(CONFIG.FICHIER_PISTES_ID).getAs('text/plain')
      .getDataAsString();
    const donnees = JSON.parse(geo);
    const graphe = construireGraphe(donnees);
    const positions = positionsLire();

    const depart = positions['DEPOT'];
    const arrivee = positions[dumpingArea];
    if (!depart || !arrivee) return null;

    const route = dijkstra(graphe, clePoint(depart), clePoint(arrivee));
    if (!route || route.length < 2) return null;
    return route;
  } catch (erreur) {
    journal('PARCOURS ECHEC ' + erreur);
    return null;
  }
}

/** Cle numerique d'un point (e,n) : arrondi au metre pour fusionner les sommets. */
function clePoint(p) {
  return Math.round(p[0]) + ',' + Math.round(p[1]);
}

/** Construit un graphe {cle: [{voisin, distance}]} depuis les LineStrings. */
function construireGraphe(geojson) {
  const graphe = {};
  function lier(a, b) {
    const ka = clePoint(a), kb = clePoint(b);
    const d = Math.hypot(b[0] - a[0], b[1] - a[1]);
    (graphe[ka] = graphe[ka] || []).push({ v: kb, d: d });
    (graphe[kb] = graphe[kb] || []).push({ v: ka, d: d });
  }
  for (const f of geojson.features || []) {
    if (!f.geometry || f.geometry.type !== 'LineString') continue;
    const pts = f.geometry.coordinates;
    for (let i = 0; i + 1 < pts.length; i++) lier(pts[i], pts[i + 1]);
  }
  return graphe;
}

/** Dijkstra simple (file triee par tableau : quelques centaines de sommets). */
function dijkstra(graphe, depart, arrivee) {
  const dist = {}, prec = {}, vus = {};
  dist[depart] = 0;
  while (true) {
    let meilleur = null, dMin = Infinity;
    for (const k in dist) {
      if (!vus[k] && dist[k] < dMin) { meilleur = k; dMin = dist[k]; }
    }
    if (meilleur === null) break;
    if (meilleur === arrivee) break;
    vus[meilleur] = true;
    for (const arc of graphe[meilleur] || []) {
      const total = dMin + arc.d;
      if (dist[arc.v] === undefined || total < dist[arc.v]) {
        dist[arc.v] = total;
        prec[arc.v] = meilleur;
      }
    }
  }
  if (dist[arrivee] === undefined) return null;
  const chemin = [];
  for (let k = arrivee; k; k = prec[k]) {
    const [e, n] = k.split(',').map(Number);
    chemin.unshift([e, n]);
    if (k === depart) break;
  }
  return chemin;
}

// ============================================================
//  GET /blasts â€” liste des blasts du site (contrat client Â§2)
// ============================================================

/**
 * Format exact attendu par le client (BlastServeur.depuisJson) :
 *   { "ok": true, "blasts": [ { numero, carte, libelle_carte, blocs: [...], plan_url } ] }
 * plan_url pointe SUR CE SERVEUR (?action=plan&carte=A1&token=...) : le
 * telechargement reste sur le meme hote, le jeton ne quitte pas le domaine.
 */
function referentielsLire() {
  const profils = lireTable(CONFIG.ONGLETS.PROFILS)
      .map((p) => ({
        code: String(p.code || '').trim(),
        libelle: String(p.libelle || '').trim(),
        titre: String(p.titre || '').trim(),
        role_cdc: String(p.role_cdc || '').trim(),
        icone: String(p.icone || '').trim(),
        ordre: Number(p.ordre) || 0,
        actif: p.actif === true || String(p.actif).toLowerCase() === 'true' || Number(p.actif) === 1 ? 1 : 0,
      }))
      .filter((p) => p.code && p.libelle && p.role_cdc);
  // Identifiants proposes au login (personnes equipes de spotters).
  const equipements = lireTable(CONFIG.ONGLETS.IDENTIFIANTS)
      .map((e) => ({
        profil: String(e.profil || '').trim(),
        id: String(e.id || '').trim(),
        nom: String(e.nom || '').trim(),
        role: String(e.role || '').trim(),
        equipe: String(e.equipe || '').trim(),
        actif: e.actif === true || String(e.actif).toLowerCase() === 'true' || Number(e.actif) === 1 ? 1 : 0,
      }))
      .filter((e) => e.profil && e.id);
  // Flotte de DT : `type` porte la FAMILLE (1500/785/ADT) et `id` le NUMERO
  // du camion. La cle JSON reste `dts` pour ne pas casser les tablettes
  // deja deployees qui lisent ce nom : c'est un detail de contrat reseau,
  // pas le nom de l'onglet cote Spreadsheet.
  const dts = lireTable(CONFIG.ONGLETS.FLOTTE)
      .map((d) => ({
        // `role` = profil propriétaire de la famille (DT, EXCAVATOR...) —
        // c'est la JOINTURE que le client applique, sans deduction.
        role: String(d.role || '').trim(),
        type: String(d.famille || '').trim(),
        id: String(d.numero || '').trim(),
        actif: d.actif === true || String(d.actif).toLowerCase() === 'true' || Number(d.actif) === 1 ? 1 : 0,
      }))
      .filter((d) => d.type && d.id);

  // CohÃ©rence :
  //   - profils uniques ;
  //   - UNIQUE(famille, numero) pour la flotte (785/1 et 1500/1 coexistent) ;
  //   - strict : chaque profil MACHINE actif a au moins un engin flotte
  //     ACTIF de sa famillle â€” sinon les tablettes concernÃ©es ne peuvent
  //     pas se connecter du tout ;
  //   - tolÃ¨re : SPOT sans membres (phase d'installation des Ã©quipes).
  const codesProfils = profils.map((p) => p.code);
  // Familles d'un profil = celles que la FLOTTE lui rattache via `role`.
  // AUCUNE liste en dur : la base est la seule source de verite.
  const famillesParRole = dts.reduce((acc, d) => {
    const r = String(d.role || '').trim().toUpperCase();
    if (r) (acc[r] = acc[r] || new Set()).add(String(d.type).trim().toUpperCase());
    return acc;
  }, {});
  const enginsActifsParFamille = new Set(
    dts.filter((d) => d.actif).map((d) => String(d.type).trim().toUpperCase()));
  // Le profil personne porte role_cdc = 'SPOTTER' (code SPOT) : le comparer
  // strictement a 'SPOT' le classait machine et le refus etait systematique.
  const PROFIL_MACHINE = (p) => {
    const role = String(p.role_cdc || '').trim().toUpperCase();
    return role !== '' && !role.includes('SPOT');
  };
  const manqueMachine = profils.filter((p) => {
    if (!PROFIL_MACHINE(p) || !p.actif) return false;
    const role = String(p.role_cdc || '').trim().toUpperCase();
    const familles = (famillesParRole[role] ||
                      famillesParRole[String(p.code).trim().toUpperCase()] || new Set());
    // Le profil machine est valide s'il possede AU MOINS une famille
    // flotte, et que cette famille a un engin actif.
    return [...familles].every((f) => !enginsActifsParFamille.has(f));
  });
  const manquePersonne = profils.filter((p) =>
    !PROFIL_MACHINE(p) && p.actif &&
    !equipements.some((e) => e.profil === p.code && e.actif));
  if (!profils.length ||
      new Set(codesProfils).size !== profils.length ||
      new Set(dts.map((d) => d.type + '::' + d.id)).size !== dts.length ||
      manqueMachine.length) {
    return corps(false, 'referentiels absents ou incoherents');
  }
  // La cle JSON reste `equipements` : les tablettes deja deployees lisent
  // ce nom et n'ont pas a etre mises a jour en meme temps que le serveur.
  return corps(true, {
    referentiels_version: 1,
    profils: profils,
    equipements: equipements,
    dts: dts,
    // Info, pas un refus : les spotters seront crees/cadres par l'app.
    avertissements: manquePersonne.length
      ? ['profil sans membre actif : ' +
         manquePersonne.map((p) => p.code).join(', ')]
      : [],
  });
}

/** Compare deux numeros de blast (Â« 106 Â», Â« 232.5 Â») numeriquement. */
function comparerNumeros(a, b) {
  const na = Number(a), nb = Number(b);
  if (isFinite(na) && isFinite(nb) && na !== nb) return na - nb;
  return String(a).localeCompare(String(b));
}

function blastsLire() {
  const blasts = lireTable(CONFIG.ONGLETS.BLASTS);
  const blocs = lireTable(CONFIG.ONGLETS.BLOCS);
  // `cartes` n'est plus un simple cle/valeur : on indexe par `code` pour
  // rendre le libelle (et les composants de nomenclature) au client.
  const cartes = {};
  for (const c of lireTable(CONFIG.ONGLETS.CARTES)) {
    const code = String(c.code || '').trim();
    if (code) cartes[code] = c;
  }

  // Chaque bloc porte SA carte (son RL). On indexe par PATTERN du blast
  // (le vrai numero de blast), et non par `blocs.blast` qui peut encore
  // contenir un flitch issu d'une ancienne amorce.
  const blocsParBlast = {};
  const blocsParBlastCarte = {};
  for (const b of blocs) {
    const num = String(b.numero || '').trim();
    const carteBloc = String(b.carte || '').trim();
    if (num === '' || carteBloc === '') continue;
    const d = decoderCarte(carteBloc);
    if (!d || !d.numero) continue;
    const numBlast = String(d.numero);
    (blocsParBlast[numBlast] = blocsParBlast[numBlast] || []).push(num);
    const cle = numBlast + '||' + carteBloc;
    (blocsParBlastCarte[cle] = blocsParBlastCarte[cle] || []).push(num);
  }

  // Regroupement par NUMERO DE BLAST, et non par le numero stocke dans
  // l'onglet `blasts` : le vrai identifiant de blast est le PATTERN de la
  // carte (decoderCarte(...).numero = pattern), tandis que le flitch est le
  // RL. Une ancienne amorce a pu ecrire le flitch dans `blasts.numero` ; on
  // ne s'en sert donc jamais. Deux cartes de meme pattern (ex. 260_..._113_6
  // et 262.5_..._113_5) deviennent UN SEUL blast 113, avec ses deux RL.
  const parPattern = {};
  for (const b of blasts) {
    const code = String(b.carte || '').trim();
    if (code === '') continue;
    const d = decoderCarte(code);
    if (!d || !d.numero) continue;
    const numBlast = String(d.numero);
    if (!parPattern[numBlast]) parPattern[numBlast] = [];
    if (parPattern[numBlast].indexOf(code) < 0) {
      parPattern[numBlast].push(code);
    }
  }
  // Cartes presentes dans `cartes` mais absentes de `blasts` : on les
  // rattache aussi par pattern, sinon un blast sans ligne `blasts`
  // disparaitrait de la liste.
  for (const code of Object.keys(cartes)) {
    const d = decoderCarte(code);
    if (!d || !d.numero) continue;
    const numBlast = String(d.numero);
    if (!parPattern[numBlast]) parPattern[numBlast] = [];
    if (parPattern[numBlast].indexOf(code) < 0) {
      parPattern[numBlast].push(code);
    }
  }

  return corps(true, {
    blasts: Object.keys(parPattern).sort(comparerNumeros).map((numBlast) => {
      const declarees = parPattern[numBlast];
      // Les cartes reellement connues des blocs font foi ; les cartes de
      // l'onglet `blasts` servent de repli quand `blocs` est vide.
      const cartesListe = declarees.slice();
      const code = cartesListe[0];
      const carte = cartes[code] || {};
      // Blocs rattaches a leur RL : { carte, flocs: [...] }. Le client sait
      // ainsi exactement quels blocs appartiennent a quel RL.
      const blocsParCarte = cartesListe.map((c) => ({
        carte: c,
        flitch: (decoderCarte(c) || {}).flitch || '',
        blocs: (blocsParBlastCarte[numBlast + '||' + c] || []),
        // URL du plan de CETTE carte (une par RL). Sans ce champ, le client
        // ne peut afficher que le plan de la premiere carte du blast.
        plan_url: urlPlanDrive(c),
      }));
      const totalBlocs = blocsParCarte.reduce(
        (t, e) => t + e.blocs.length, 0);
      return {
        numero: numBlast,
        // Legacy : on garde `carte` (1ere) pour les clients non migres.
        carte: code,
        // Liste des cartes (une par RL).
        cartes: cartesListe,
        // Blocs regroupes par carte (RL).
        blocs_par_carte: blocsParCarte,
        libelle_carte: String(carte.libelle || ''),
        // Legacy : liste plate (tous les blocs, tous RL confondus).
        blocs: blocsParBlast[numBlast] || [],
        nombre_blocs: totalBlocs,
        plan_url:
          urlPlanDrive(code) ||
          (baseUrl() + '?action=plan&carte=' + encodeURIComponent(code)),
      };
    }),
  });
}

/** Racine de l'URL de la Web App (auto-detectee au premier appel). */
function baseUrl() {
  const props = PropertiesService.getScriptProperties();
  let url = props.getProperty('base_url');
  if (!url) {
    url = ScriptApp.getService().getUrl() || '';
    if (url) props.setProperty('base_url', url);
  }
  return url;
}

