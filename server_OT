function mimePlan(nom, mimeDrive) {
  const m = String(mimeDrive || '').toLowerCase();
  if (m.indexOf('image/') === 0) return m;
  const ext = String(nom || '').toLowerCase().split('.').pop();
  if (ext === 'png') return 'image/png';
  if (ext === 'gif') return 'image/gif';
