/**
 * Premiere ligne de DONNEES de l'onglet `evenements`.
 *
 * 1 = pas d'entete (ancien format, donnees des la ligne 1).
 * 2 = entete en ligne 1 (format courant).
 *
 * Detecte a chaque lecture via `ligneDebutEvenements()` : une migration
 * partielle (entete posee sur un onglet deja rempli) ne doit jamais faire
 * relire la ligne de titres comme un evenement.
 */
function ligneDebutEvenements(sh) {
  if (sh.getLastRow() === 0) return 2;
  const premiere = String(sh.getRange(1, 1).getValue()).trim();
  // Un event_id valide = UUID. Tout le reste (titre « event_id » inclus)
  // signifie qu'une entete est presente.
  return /^[0-9a-f-]{36}$/i.test(premiere) ? 1 : 2;
}

/**
 * Cree les onglets manquants du Spreadsheet, avec leur entete quand il en
 * faut une. Idempotent : un onglet existant n'est jamais touche (ni ses
 * donnees, ni son entete), on ne comble que les absents.
 *
 * Appele automatiquement par doGet/doPost (leger : une lecture de noms, une
 * insertion seulement si manquant) et executable a la main depuis l'editeur
 * (fonction initialiser) pour verifier le deploiement.
 */
/** Vrai quand initialiser() a deja tourne dans CETTE execution Apps Script. */
var INITIALISE_POUR_EXECUTION = false;

function initialiser() {
  // Perf (27/10) : voir INITIALISE_POUR_EXECUTION. Sans cette sortie, le POST
  // d'un evenement payait l'ouverture du classeur + la relecture de lotte
  // et equipements a chaque fois (7,9 s mesure), d'ou la redirection 302
  // sans corps et des evenements bloques en file.
  if (INITIALISE_POUR_EXECUTION) return 'deja fait';
  INITIALISE_POUR_EXECUTION = true;
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  // Migration avant la creation des onglets : elle convertirait sinon dans
  // le vide si `flotte` venait d'etre creee vide par sa propre boucle
  // (ecrireTable cree l'onglet absent, la migration peut donc tourner
  // en premier â€” c'est elle qui peuple `flotte` depuis `dts`).
  migrerStructuration(ss);
  // evenements : ENTETE en ligne 1 (figee), donnees a partir de la ligne 2.
  // Sans entete, le sheet etait illisible (9 colonnes sans titres) ; avec un
  // entete mal geree, la ligne de titres deviendrait un evenement fantome.
  // Les lectures/ecritures sont donc decalees explicitement (voir
  // `LIGNE_DEBUT_EVENEMENTS`).
  if (!ss.getSheetByName(CONFIG.ONGLETS.EVENEMENTS)) {
    const sh = ss.insertSheet(CONFIG.ONGLETS.EVENEMENTS);
    sh.getRange(1, 1, 1, COLONNES_EVENEMENTS.length)
      .setValues([COLONNES_EVENEMENTS]).setFontWeight('bold')
      .setBackground('#f3f3f3');
    sh.setFrozenRows(1);
  } else {
    const sh = ss.getSheetByName(CONFIG.ONGLETS.EVENEMENTS);
    // ENTETE PHYSIQUE : completer la ligne 1 jusqu'a COLONNES_EVENEMENTS.
    // Sans cela, un onglet cree avant l'ajout des colonnes perle (27/10)
    // restait a 10 titres alors que les ecritures en posaient 18.
    try {
      const largeur = sh.getLastColumn();
      if (largeur < COLONNES_EVENEMENTS.length) {
        sh.getRange(1, 1, 1, COLONNES_EVENEMENTS.length)
          .setValues([COLONNES_EVENEMENTS]).setFontWeight('bold')
          .setBackground('#f3f3f3');
        sh.setFrozenRows(1);
        journal('MIGRATION entete evenements : ' +
                COLONNES_EVENEMENTS.length + ' colonnes');
      }
    } catch (_) { /* entete illisible : on ne bloque pas l'ecriture */ }
    // Onglet deja rempli par des evenements SANS entete : on ne decale RIEN
    // de force (les donnees existantes resteraient en ligne 1 et seraient
    // lues comme un event_id invalide). On signale seulement.
    const premiere = sh.getLastRow() > 0
      ? String(sh.getRange(1, 1).getValue())
      : '';
    if (!premiere || /^[0-9a-f-]{36}$/i.test(premiere)) {
      Logger.log('evenements : entete absente (ligne 1 = donnee). ' +
                 'Lancer migrationEnteteEvenements() pour la poser.');
    }
  }

  for (const [cle, entete] of Object.entries(SCHEMAS)) {
    const nom = CONFIG.ONGLETS[cle.toUpperCase()] || cle;
    let sh = ss.getSheetByName(nom);
    if (!sh) {
      sh = ss.insertSheet(nom);
      sh.getRange(1, 1, 1, entete.length).setValues([entete]).setFontWeight('bold');
      sh.setFrozenRows(1);
      continue;
    }
    if (!entete.length) continue;
    // Onglet deja present : on complete l'entete si elle est vide ou si des
    // colonnes du schema manquent a la suite (ex. `cartes` passe de 2 a 8
    // colonnes). On n'ecrase JAMAIS une colonne existante : les donnees en
    // place restent alignees sur leur entete. Aucune ligne de donnee n'est
    // touchee â€” on n'ecrit que la ligne 1.
    const actuels = sh.getLastColumn()
      ? sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0]
          .map((v) => String(v).trim())
      : [];
    const manquants = [];
    for (let i = 0; i < entete.length; i++) {
      if (actuels[i] !== entete[i]) { manquants.push({ index: i, nom: entete[i] }); }
    }
    if (!manquants.length) continue;
    // Reecrit la ligne 1 en entier quand elle est vide ou incompatible ; sinon
    // n'ajoute que les colonnes absentes a la fin.
    if (sh.getLastRow() === 0 || !actuels.some((v) => v !== '')) {
      sh.getRange(1, 1, 1, entete.length).setValues([entete]).setFontWeight('bold');
      sh.setFrozenRows(1);
    } else {
      sh.getRange(1, actuels.length + 1, 1, manquants.length)
        .setValues([manquants.map((m) => m.nom)]).setFontWeight('bold');
    }
  }
}

/** Point d'entree manuel (menu Run de l'editeur Apps Script). */
function initialiserOnglets() {
  initialiser();
  Logger.log('Onglets verifies : ' + Object.values(CONFIG.ONGLETS).join(', '));
}

/**
 * Pose l'entete de l'onglet `evenements` sur un onglet deja rempli.
 *
 * Menu Run ▶ migrationEnteteEvenements.
 *
 * Insere une ligne en tete et y ecrit les 9 titres ; les donnees existantes
 * descendent d'une ligne (lignes 1..N deviennent 2..N+1) sans aucune
 * modification de leur contenu. Idempotente : si la ligne 1 est deja un
 * UUID, elle sort immediatement ; si une entete est deja posee, aussi.
 *
 * Sans cette fonction, ajouter l'entete a la main decalerait la detection
 * d'idempotence (`ligneDebutEvenements` lit la ligne 1 pour savoir si une
 * entete est presente).
 */
function migrationEnteteEvenements() {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sh = ss.getSheetByName(CONFIG.ONGLETS.EVENEMENTS);
  if (!sh) { Logger.log('Onglet evenements absent.'); return 'absent'; }
  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, COLONNES_EVENEMENTS.length)
      .setValues([COLONNES_EVENEMENTS]).setFontWeight('bold');
    sh.setFrozenRows(1);
    Logger.log('Onglet vide : entete posee.');
    return 'entete posee (vide)';
  }
  const premiere = String(sh.getRange(1, 1).getValue()).trim();
  if (!/^[0-9a-f-]{36}$/i.test(premiere)) {
    // Entete deja presente : on COMPLETE si elle n'a pas encore la colonne
    // `elevation` (ajout du 22/10). On n'ecrase jamais un titre existant.
    const actuels = sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn()))
      .getValues()[0].map((v) => String(v).trim());
    const manquants = COLONNES_EVENEMENTS.slice(actuels.length);
    if (manquants.length) {
      sh.getRange(1, actuels.length + 1, 1, manquants.length)
        .setValues([manquants]).setFontWeight('bold');
      const r = 'entete complete : ' + manquants.join(', ');
      journal('MIGRATION ' + r);
      Logger.log(r);
      return r;
    }
    Logger.log('Entete deja presente en ligne 1 : ' + premiere);
    return 'deja presente';
  }
  // Insertion d'une ligne vide en 1 : les donnees descendent, intactes.
  sh.insertRowBefore(1);
  sh.getRange(1, 1, 1, COLONNES_EVENEMENTS.length)
    .setValues([COLONNES_EVENEMENTS]).setFontWeight('bold')
    .setBackground('#f3f3f3');
  sh.setFrozenRows(1);
  const rapport = 'entete posee, ' + (sh.getLastRow() - 1) + ' evenement(s) decale(s)';
  journal('MIGRATION ' + rapport);
  Logger.log(rapport);
  return rapport;
}

// ============================================================
//  ROUTEUR
// ============================================================

function doGet(e) {
  return reponse(function () {
    initialiser(); // cree les onglets manquants (idempotent, leger)
    const p = e.parameter || {};
    verifierToken(p.token);
    switch (p.action) {
      case 'affectation':  return affectationLire();
      case 'blasts':       return blastsLire();
      case 'referentiels': return referentielsLire();
      case 'plans':        return plansInventaire();
      case 'plan':         return planServir(p.carte || '');
      case 'sante':        return sante();
      case 'migrer':       return migrationExecuter();
      case 'diagnostic':   return referentielsDiagnostic();
      case 'notifications': return notificationsLire(p.depuis);
      case 'donnees':      return donneesLire(p.onglet);
      default:
        return corps(false, 'action inconnue : ' + (p.action || '(absente)'));
    }
  }, true /* binaire possible */);
}

function doPost(e) {
  return reponse(function () {
    const p = e.parameter || {};
    verifierToken(p.token);
    if (p.action === 'evenement') {
      // CHEMIN CHAUD : aucun initialiser() ici. L'ecriture d'un evenement
      // ne cree aucun onglet ; initialiser a chaque GPS (5 s) faisait
      // depasser le delai d'Apps Script (302 sans corps, file bloquee).
      return evenementTraiter(e.postData ? e.postData.contents : '');
    }
    if (p.action === 'notification') {
      return notificationEcrire(e.postData ? e.postData.contents : '');
    }
    if (p.action === 'donnees') {
      return donneesEcrire(e.postData ? e.postData.contents : '');
    }
    return corps(false, 'action POST inconnue : ' + (p.action || '(absente)'));
  });
}

/** Enveloppe chaque handler : une exception sort en ok:false, jamais en page d'erreur. */
function reponse(traitement, binairePossible) {
  try {
    const valeur = traitement();
    // ContentService n'est pas une fonction constructeur : `instanceof` sur le
    // global jette Â« Right-hand side of 'instanceof' is not callable Â». On
    // reconnait un TextOutput deja construit (reponse binaire/plan) a sa forme.
    if (valeur && typeof valeur.getContent === 'function' && typeof valeur !== 'string') {
      return valeur;
    }
    return ContentService
      .createTextOutput(JSON.stringify(valeur))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (erreur) {
    if (binairePossible && erreur instanceof ReponseBinaire) return erreur.sortie;
    return ContentService
      .createTextOutput(JSON.stringify({ ok: false, erreur: String(erreur) }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

/** Exception intermediaire pour livrer un binaire (plan JPG) via doGet. */
function ReponseBinaire(sortie) { this.sortie = sortie; }

/** Corps JSON standard : tout passe par le marqueur ok. */
function corps(ok, ...champs) {
  // corps(true, {cle: valeur}) ou corps(false, 'message') â€” les deux formes.
  if (typeof ok !== 'object' && champs.length === 1 && typeof champs[0] === 'string') {
    return { ok: ok, erreur: champs[0] };
  }
  const objet = { ok: true };
  for (const c of champs) if (c && typeof c === 'object') Object.assign(objet, c);
  return objet;
}

// ============================================================
//  AUTH â€” jeton en parametre de requete (en-tetes invisibles sur GAS)
// ============================================================

function verifierToken(recu) {
  if (!recu || recu !== CONFIG.TOKEN) {
    throw 'token absent ou refuse';
  }
}

// ============================================================
//  SPREADSHEET â€” acces aux onglets
// ============================================================

function feuille(nom) {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sh = ss.getSheetByName(nom);
  if (!sh) throw 'onglet manquant : ' + nom;
  return sh;
}

/** Lit un onglet cle/valeur (ex. affectation) en objet JS. */
function lireCleValeur(nom) {
  const donnees = feuille(nom).getDataRange().getValues();
  const objet = {};
  for (const ligne of donnees) {
    if (ligne[0] !== '') objet[ligne[0]] = ligne[1];
  }
  return objet;
}

/**
 * Lit les points fixes en paires de metres UTM. Format de l'onglet :
 * `code | easting | northing` (contrairement aux onglets cle/valeur).
 */
function positionsLire() {
  return lireTable(CONFIG.ONGLETS.POSITIONS).reduce((resultat, ligne) => {
    const code = String(ligne.code || '').trim();
    const easting = Number(ligne.easting);
    const northing = Number(ligne.northing);
    if (!code || !isFinite(easting) || !isFinite(northing)) return resultat;
    resultat[code] = [easting, northing];
    return resultat;
  }, {});
}

/** Onglet en tableau d'objets (entete = 1re ligne, cles des colonnes). */
function lireTable(nom) {
  const valeurs = feuille(nom).getDataRange().getValues();
  if (valeurs.length < 2) return [];
  const entete = valeurs[0];
  return valeurs.slice(1).map((ligne) => {
    const o = {};
    entete.forEach((cle, i) => { o[cle] = ligne[i]; });
    return o;
  });
}

// ============================================================
//  SYNCHRONISATION GENERIQUE â€” GET/POST ?action=donnees
// ============================================================
//
//  Lecture et ecriture d'un onglet synchronisable, designe par son nom de
//  CONTRAT (identique a celui utilise par le serveur local) :
//
//      GET  ?action=donnees&onglet=flotte
//           -> { ok, onglet, nom_onglet, entete:[...], lignes:[{...}] }
//
//      POST ?action=donnees
//           corps JSON : { onglet, lignes:[{...}] }
//           -> { ok, onglet, ecrites:N }
//
//  Le jeton reste dans la query string (le corps ne sert qu'a la charge
//  utile) : c'est la meme convention que les autres actions.

/** Onglets synchronisables : nom de contrat -> cle de CONFIG.ONGLETS. */
const ONGLETS_SYNC = {
  profils: 'PROFILS',
  identifiants: 'IDENTIFIANTS',
  flotte: 'FLOTTE',
  positions: 'POSITIONS',
  affectation: 'AFFECTATION',
  tab: 'TAB',
  equipements: 'EQUIPEMENTS',
};

/** Colonnes forcees en texte brut (chaines qui ressemblent a des nombres). */
const COLONNES_TEXTE_SYNC = {
  flotte: ['famille', 'numero'],
  identifiants: ['id'],
  profils: ['code'],
  positions: ['code'],
  tab: ['id'],
  equipements: ['id'],
};

/** Resout un nom de contrat en nom d'onglet reellement present. */
function nomOngletSync(contrat) {
  const cle = ONGLETS_SYNC[String(contrat || '').trim().toLowerCase()];
  if (!cle) return '';
  return CONFIG.ONGLETS[cle] || '';
}

/** Entete brute d'un onglet (liste de chaines). */
function lireEntete(nom) {
  const sh = feuille(nom);
  if (!sh.getLastColumn()) return [];
  return sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0]
      .map(v => String(v).trim());
}

/** GET ?action=donnees&onglet=X : lecture brute d'un onglet synchronisable. */
function donneesLire(contrat) {
  const nom = nomOngletSync(contrat);
  if (!nom) return corps(false, 'onglet non synchronisable : ' + (contrat || '(absent)'));
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  if (!ss.getSheetByName(nom)) return corps(false, 'onglet manquant : ' + nom);
  return corps(true, {
    onglet: String(contrat).trim(),
    nom_onglet: nom,
    entete: lireEntete(nom),
    lignes: lireTable(nom),
  });
}

/** POST ?action=donnees : ecriture complete d'un onglet synchronisable. */
function donneesEcrire(brut) {
  let p = {};
  try { p = JSON.parse(brut || '{}'); } catch (_) { return corps(false, 'corps illisible (JSON attendu)'); }
  const contrat = String(p.onglet || '').trim().toLowerCase();
  const nom = nomOngletSync(contrat);
  if (!nom) return corps(false, 'onglet non synchronisable : ' + (contrat || '(absent)'));
  const lignes = Array.isArray(p.lignes) ? p.lignes : [];

  // `affectation` est un onglet cle/valeur : on NE le reecrit pas (le
  // parcours calcule et `valide_le` seraient perdus), on met a jour les
  // cles fournies et on laisse les autres intactes.
  if (contrat === 'affectation') {
    return ecrireAffectationCles(nom, lignes);
  }

  const entete = (SCHEMAS[contrat] && SCHEMAS[contrat].length)
    ? SCHEMAS[contrat]
    : lireEntete(nom);
  if (!entete.length) return corps(false, 'entete de l\'onglet illisible : ' + nom);

  const valeurs = lignes.map((l) => entete.map((col) => valeurCellule(l, col)));
  ecrireTable(nom, entete, valeurs, COLONNES_TEXTE_SYNC[contrat] || []);
  return corps(true, { onglet: contrat, nom_onglet: nom, ecrites: valeurs.length });
}

/** Valeur d'une cellule, normalisee pour Sheets (booleens, nombres, texte). */
function valeurCellule(ligne, col) {
  let v = (ligne && typeof ligne === 'object') ? ligne[col] : ligne;
  if (v === undefined || v === null) v = '';
  if (col === 'actif') {
    if (typeof v === 'boolean') return v;
    if (typeof v === 'number') return v !== 0;
    return /^(1|true|oui|yes|vrai|actif)$/i.test(String(v).trim());
  }
  if (typeof v === 'boolean') return v;
  if (typeof v === 'number') return v;
  return String(v);
}

/** Ecriture partielle de l'onglet cle/valeur `affectation`. */
function ecrireAffectationCles(nom, lignes) {
  const fusion = lireCleValeur(nom);
  for (const l of lignes) {
    const cle = String((l && l.cle) || '').trim();
    if (!cle) continue;
    fusion[cle] = (l.valeur === undefined || l.valeur === null) ? '' : l.valeur;
  }
  const cles = Object.keys(fusion);
  ecrireTable(nom, SCHEMAS.affectation, cles.map(k => [k, fusion[k]]), []);
  return corps(true, { onglet: 'affectation', nom_onglet: nom, ecrites: lignes.length });
}

// ============================================================
//  POST /evenements â€” file d'entree (CDC Â§3)
// ============================================================

/** Types d'evenements acceptes (CDC Â§3.2). */
const TYPES_ACCEPTES = [
  'GPS_UPDATE', 'LINE_ADD', 'BLAST_LOCK',
  'BLAST_UNLOCK', 'BLAST_SEND', 'BLE_RELAY',
  // Position du godet (perle) et sa moyenne de session, emises par
  // l'ecran Excavator. OUBLIEES ici : le serveur les refusait en 400,
  // la tablette les renvoyait sans fin et la file grossissait (27/10).
  'POSITION_PERLE', 'MOYENNE_PERLE',
];

/**
 * Valide l'enveloppe, verifie l'unicite d'event_id (idempotence REQ-015)
 * et l'ecrit dans l'onglet evenements. Un doublon renvoie status DOUBLON,
 * que le client traite comme un succes (equivalent 409 du CDC).
 */
function evenementTraiter(brut) {
  let enveloppe;
  try {
    enveloppe = JSON.parse(brut);
  } catch (_) {
    return corps(false, 'corps illisible (JSON attendu)');
  }
  if (!enveloppe || typeof enveloppe !== 'object') {
    return corps(false, 'enveloppe absente');
  }
  if (enveloppe.vers_protocole && enveloppe.vers_protocole !== CONFIG.VERSION_PROTOCOLE) {
    // Regle CDC Â§2 adaptee : le protocole est verifie dans le corps.
    return corps(false, 'protocole refuse : ' + enveloppe.vers_protocole);
  }

  const id = String(enveloppe.event_id || '');
  const type = String(enveloppe.event_type || '');
  if (!id || !/^[0-9a-f-]{36}$/i.test(id)) {
    return corps(false, 'event_id absent ou mal forme (UUID attendu)');
  }
  if (TYPES_ACCEPTES.indexOf(type) < 0) {
    return corps(false, 'event_type inconnu : ' + type);
  }
  if (!enveloppe.payload || typeof enveloppe.payload !== 'object') {
    return corps(false, 'payload manquant pour ' + type);
  }
  if (type === 'GPS_UPDATE' && !payloadGpsValide(enveloppe.payload)) {
    return corps(false, 'GPS_UPDATE sans easting/northing valides');
  if (type === 'POSITION_PERLE' && !payloadPerleValide(enveloppe.payload)) {
    return corps(false, 'POSITION_PERLE sans xbloc/ybloc/zbloc valides');
  }
  if (type === 'MOYENNE_PERLE' && !payloadMoyenneValide(enveloppe.payload)) {
    return corps(false, 'MOYENNE_PERLE sans xmoy/ymoy/zmoy valides');
  }
  }

  const sh = feuille(CONFIG.ONGLETS.EVENEMENTS);
  const verrou = LockService.getScriptLock();
  // Un client repondant en < 1 s : 5 s de lock suffisent et protegent
  // deux tablettes qui poussent au meme instant. 30 s depassait le delai
  // de reponse d'Apps Script : la Web App repondait par une REDIRECTION 302
  // (vers script.googleusercontent.com) que le client ne sait pas suivre —
  // il croyait a un echec et gardait l'evenement en file, alors que
  // l'ecriture avait bien eu lieu (observe 22/10 : 174 evenements bloques).
  verrou.waitLock(5000);
  try {
    const debut = ligneDebutEvenements(sh);
    const dernieres = sh.getLastRow();
    const totalDonnees = Math.max(0, dernieres - debut + 1);
    // Idempotence (REQ-015) : balayage des event_ids existants. La colonne A
    // est l'event_id. Profondeur 200 au lieu de 2000 : un doublon survient
    // quelques secondes apres l'original (le client rejoue des qu'un ACK
    // manque), donc il est toujours dans les 200 dernieres lignes. Lire 2000
    // lignes a chaque envoi faisait depasser le delai de reponse et
    // declenchait la redirection 302 — c'est la cause premiere du blocage.
    // Au pire, un doublon tres ancien passe : une ligne en double dans le
    // sheet, jamais une perte d'evenement.
    const profondeur = Math.min(totalDonnees, 200);
    if (profondeur > 0) {
      const ids = sh.getRange(dernieres - profondeur + 1, 1, profondeur, 1).getValues();
      for (const ligne of ids) {
        if (String(ligne[0]) === id) {
          return corps(true, {
            ack: { event_id: id, status: 'DOUBLON', received_at: maintenant() },
          });
        }
      }
    }

    // Ecriture : une ligne par evenement, payload en texte brut.
    // `getRange(...).setValues()` plutot qu'`appendRow` : appendRow ecrit
    // toujours APRES la derniere ligne remplie, ce qui est correct ici, mais
    // setValues rend la ligne visee explicite (et evite une ligne vide
    // intercalaires quand une colonne est laissee vide).
    // ECRITURE EXPLICITE SUR LA LIGNE VISEE (27/10).
    //
    // ppendRow ecrivait a la premiere ligne vide de la FEUILLE, sans
    // garantir que l'entete physique faisait 18 colonnes. Consequence au
    // terrain : les lignes se decalaient, easting/northing/elevation
    // tombaient dans les colonnes du godet et inversement.
    //
    // On ecrit donc sur getLastRow() + 1 avec la largeur EXACTE de
    // [COLONNES_EVENEMENTS] : une ligne = un evenement, toujours aligne.
    //
    // Les cellules non concernees restent VIDEES (''), jamais mises a 0 :
    // Number(x) || 0 remplissait chaque colonne inutilisee d'un zero, si
    // bien qu'on ne pouvait plus distinguer Â« pas de valeur Â» de Â« valeur
    // nulle Â» a la lecture du sheet.
    const valeurs = [
      id,
      String(enveloppe.gateway_id || ''),
      String(enveloppe.source_device || ''),
      type,
      String(enveloppe.timestamp || ''),
      maintenant(),                              // received_at (CDC Â§3.4)
      // PAYLOAD SANS LA PHOTO (27/10).
      //
      // Une photo JPEG en base64 depasse 50 000 caracteres des qu'elle a une
      // taille terrain : Google Sheets REFUSE alors la cellule et l'evenement
      // n'est jamais enregistre (Â« Exception: votre saisie depasse le nombre
      // maximum de 50000 caracteres autorise par cellule Â»). Les LINE_ADD et
      // BLAST_SEND avec photo echouaient donc en silence.
      //
      // La photo part dans une colonne DEDIEE, decoupee en morceaux de
      // 45 000 caracteres (colonnes photo, photo_2, photo_3...). Le
      // payload garde tout le reste et un simple drapeau photo_tronquee.
      JSON.stringify(payloadSansPhoto(enveloppe.payload)),
      // Position de la TABLETTE (GPS_UPDATE uniquement).
      type === 'GPS_UPDATE' ? Number(enveloppe.payload.easting) || '' : '',
      type === 'GPS_UPDATE' ? Number(enveloppe.payload.northing) || '' : '',
      type === 'GPS_UPDATE' ? Number(enveloppe.payload.elevation) || '' : '',
      // Position du GODET (POSITION_PERLE uniquement), en coordonnees de bloc.
      type === 'POSITION_PERLE' ? Number(enveloppe.payload.xbloc) || '' : '',
      type === 'POSITION_PERLE' ? Number(enveloppe.payload.ybloc) || '' : '',
      type === 'POSITION_PERLE' ? Number(enveloppe.payload.zbloc) || '' : '',
      // Moyenne de session (MOYENNE_PERLE uniquement).
      type === 'MOYENNE_PERLE' ? Number(enveloppe.payload.xmoy) || '' : '',
      type === 'MOYENNE_PERLE' ? Number(enveloppe.payload.ymoy) || '' : '',
      type === 'MOYENNE_PERLE' ? Number(enveloppe.payload.zmoy) || '' : '',
      type === 'MOYENNE_PERLE' ? Number(enveloppe.payload.nombre) || '' : '',
      (type === 'POSITION_PERLE' || type === 'MOYENNE_PERLE')
        ? String(enveloppe.payload.dt || '') : '',
    ];
    // Ligne visee : la premiere libre APRES l'entete. getLastRow() rend la
    // derniere ligne utilisee ; +1 ne peut donc jamais recouvrir une donnee.
    const ligneVisee = sh.getLastRow() + 1;
    // PHOTO : colonnes suivantes, par morceaux (voir [morceauxPhoto]).
    for (const morceau of morceauxPhoto(enveloppe.payload)) {
      valeurs.push(morceau);
    }
    // Garde-fou final : une valeur hors limite ferait echouer TOUTE la ligne.
    // On la remplace par un marqueur plutot que de perdre l'evenement.
    const valeursSure = valeurs.map(function (v) {
      const t = String(v === null || v === undefined ? '' : v);
      return t.length > 49000
        ? '[valeur trop volumineuse : ' + t.length + ' caracteres]'
        : v;
    });
    sh.getRange(ligneVisee, 1, 1, valeursSure.length).setValues([valeursSure]);
    journal('EVENT ' + type + ' ' + id + ' de ' + (enveloppe.source_device || '?'));
    return corps(true, {
      ack: { event_id: id, status: 'SYNCED', received_at: maintenant() },
    });
  } finally {
    verrou.releaseLock();
  }
}

/** GPS_UPDATE exige easting et northing numeriques (CDC Â§3.2). */
/** POSITION_PERLE exige xbloc, ybloc et zbloc numeriques. */
/** Copie du payload SANS le champ photo (trop volumineux pour une cellule). */
function payloadSansPhoto(payload) {
  const copie = {};
  if (!payload || typeof payload !== 'object') return copie;
  for (const cle in payload) {
    if (cle === 'photo') continue;
    copie[cle] = payload[cle];
  }
  // Signale que la photo existe ailleurs, sans la dupliquer.
  if (payload.photo) copie.photo_separee = true;
  return copie;
}

/**
 * Decoupe la photo base64 en morceaux de 45 000 caracteres au plus.
 *
 * Une cellule Sheets plafonne a 50 000 : on garde de la marge. Rend une
 * liste vide s'il n'y a pas de photo, ce qui laisse les colonnes suivantes
 * vides sans decaler les autres lignes.
 */
function morceauxPhoto(payload) {
  const photo = payload && payload.photo ? String(payload.photo) : '';
  if (!photo) return [];
  const TAILLE = 45000;
  const morceaux = [];
  for (let i = 0; i < photo.length && morceaux.length < 8; i += TAILLE) {
    morceaux.push(photo.substring(i, i + TAILLE));
  }
  return morceaux;
}

function payloadPerleValide(p) {
  return p && isFinite(Number(p.xbloc)) && isFinite(Number(p.ybloc)) &&
         isFinite(Number(p.zbloc));
}

/** MOYENNE_PERLE exige xmoy, ymoy et zmoy numeriques (nombre facultatif). */
function payloadMoyenneValide(p) {
  return p && isFinite(Number(p.xmoy)) && isFinite(Number(p.ymoy)) &&
         isFinite(Number(p.zmoy));
}

function payloadGpsValide(p) {
  const e = Number(p.easting), n = Number(p.northing);
  return isFinite(e) && isFinite(n) && e !== 0 && n !== 0;
}

