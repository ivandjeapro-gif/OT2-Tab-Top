/**
 * Coeur testable : ecrit l'onglet `flotte` et rend un compte rendu texte.
 *
 * Idempotent : deux executions produisent exactement le meme contenu
 * (memes numeros, meme ordre). La numerotation est purement derivee de
 * FLOTTE_DT, sans aleatoire ni compteur persistant.
 *
 * ATTENTION : `ecrireTable` fait `sh.clear()` â€” les lignes saisies a la
 * main dans `flotte` sont remplacees. Cet onglet ne porte que la flotte.
 */
function semerFlotteDT() {
  // `ecrireTable` exige que l'onglet existe : sur un classeur neuf,
  // `flotte` n'est pas encore cree. `initialiser()` le cree (et applique
  // son entete) avant toute ecriture â€” sans cela, un premier lancement
  // echouerait sur Â« onglet manquant : flotte Â».
  initialiser();

  const lignes = [];
  const rangees = [];
  let numero = 1;

  for (const fr of FLOTTE_ROLES) {
    for (const famille of fr.familles) {
      const code = String(famille.code || '').trim();
      const nombre = Number(famille.nombre) || 0;
      if (!code || nombre < 1) {
        lignes.push('IGNORE : famille invalide ' + JSON.stringify(famille));
        continue;
      }
      // Chaque engin recoit le prochain numero du parc ; le `role` rattache
      // la ligne a son profil (DT, EXCAVATOR...).
      for (let i = 0; i < nombre; i++) {
        rangees.push([fr.role, code, String(numero), true]);
        numero++;
      }
      lignes.push(
        famille.libelle + ' : ' + nombre + ' engin(s), numeros ' +
        (numero - nombre) + ' a ' + (numero - 1)
      );
    }
  }

  if (!rangees.length) {
    lignes.push('AUCUNE famille valide dans FLOTTE_DT : rien ecrit.');
    return lignes.join('\n');
  }

  // `numero` en format Texte brut : sans cela Sheets transformerait "1" en
  // nombre et l'affichage perdrait son alignement avec les autres codes.
  ecrireTableOuLoge(
    CONFIG.ONGLETS.FLOTTE, SCHEMAS.flotte, rangees, ['numero', 'famille']);

  lignes.push('flotte : ' + rangees.length + ' ligne(s) ecrite(s).');
  lignes.push(
    'Numeros de 1 a ' + (numero - 1) + ', sans doublon entre familles.'
  );
  lignes.push('Verifiez via ?action=referentiels.');
  return lignes.join('\n');
}


// ============================================================
//  DIAGNOSTIC â€” ou sont reellement les donnees de la flotte ?
// ============================================================
//
//  Menu Run â–¶ diagnostiquerOnglets
//
//  A utiliser quand une ecriture semble Â« reussie Â» dans le journal mais
//  que le contenu reste invisible a l'ecran. Le cas typique est un DOUBLON
//  DE NOM D'ONGLET : Sheets n'interdit pas deux onglets nommes pareil dans
//  des classeurs differents, et un onglet renomme `dts (1)` ne repond plus
//  a `getSheetByName('dts')`.
//
//  La fonction affiche, pour CHAQUE onglet du classeur : son nom exact
//  (entre chevrons, espaces visibles), son nombre de lignes et son
//  nombre de colonnes. On voit ainsi immediatement qui porte les 19
//  lignes et sous quel nom.
// ============================================================

function diagnostiquerOnglets() {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const lignes = [];

  lignes.push('Classeur : ' + ss.getName());
  lignes.push('URL      : ' + ss.getUrl());
  lignes.push('ID       : ' + ss.getId());
  lignes.push('');
  lignes.push('Onglets presents (' + ss.getSheets().length + ') :');

  for (const sh of ss.getSheets()) {
    const nom = sh.getName();
    // Entre chevrons pour rendre visibles les espaces parasites :
    // Â« dts Â» et Â« dts Â» (avec un espace final) sont deux onglets distincts.
    lignes.push(
      '  <' + nom + '>  lignes=' + sh.getLastRow() +
      '  colonnes=' + sh.getLastColumn()
    );
  }

  lignes.push('');
  lignes.push('Onglet attendu pour la flotte : <' + CONFIG.ONGLETS.FLOTTE + '>');
  const attendu = ss.getSheetByName(CONFIG.ONGLETS.FLOTTE);
  if (!attendu) {
    lignes.push('  ABSENT ! Les donnees sont donc dans un onglet homonyme.');
  } else {
    lignes.push(
      '  lignes=' + attendu.getLastRow() +
      ' colonnes=' + attendu.getLastColumn()
    );
    // Extrait des 5 premieres lignes pour confirmer le contenu reel.
    const apercu = attendu.getLastRow() > 0
      ? attendu.getRange(1, 1,
          Math.min(5, attendu.getLastRow()),
          Math.max(1, Math.min(3, attendu.getLastColumn()))).getValues()
      : [];
    lignes.push('  apercu :');
    for (const r of apercu) {
      lignes.push('    [' + r.map((v) => String(v)).join(' | ') + ']');
    }
  }

  Logger.log(lignes.join('\n'));
  return lignes.join('\n');
}

// ============================================================
//  STRUCTURATION â€” separation flotte / tab / equipements
// ============================================================
//
//  Ancien modele (confus) :
//    `equipements` = identifiants de login ET flotte DT melanges
//    `dts`         = flotte DT (18 lignes) ET tablettes BLE
//
//  Nouveau modele, un onglet par nature :
//    `identifiants` : ce que l'utilisateur choisit au login
//    `flotte`       : les DT du site (famille 1500/785/ADT + numero)
//    `tab`          : les tablettes / boites BLE (TAB3-01...)
//    `equipements`  : le materiel (GNSS, capteurs...), reserve
//
//  La migration est IDEMPOTENTE et ne detruit rien :
//    1. `identifiants` absent mais `equipements` present
//         -> `equipements` est copie en `identifiants`
//    2. `flotte` absente mais `dts` present
//         -> les lignes de `dts` sont converties en `flotte`
//            (type|id -> famille|numero) ET `tab` est cree vide
//    3. `tab` absent -> cree vide avec son entete
//
//  Aucun onglet source n'est supprime : on peut verifier, puis ranger
//  a la main. Chaque etape journalise son resultat.
//
//  Lancee par `initialiser()` a chaque appel HTTP. Declenchement manuel :
//  Run â–¶ migrerStructurationManuel
// ============================================================

function migrerStructurationManuel() {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  Logger.log(migrerStructuration(ss, true));
}

/**
 * @param {Spreadsheet} ss classeur cible
 * @param {boolean=} verbeux true pour rendre un compte rendu texte
 * @return {string} compte rendu (vide si rien a faire et non verbeux)
 */
function migrerStructuration(ss, verbeux) {
  const faits = [];

  // --- 1. identifiants <- equipements -----------------------------------
  const idents = ss.getSheetByName(CONFIG.ONGLETS.IDENTIFIANTS);
  if (!idents) {
    const ancienEq = ss.getSheetByName(CONFIG.ONGLETS.EQUIPEMENTS);
    if (ancienEq) {
      const valeurs = ancienEq.getLastRow() > 0
        ? ancienEq.getDataRange().getValues()
        : [];
      const copie = ancienEq.copyTo(ss).setName(CONFIG.ONGLETS.IDENTIFIANTS);
      copie.setFrozenRows(1);
      faits.push('identifiants <- equipements (' +
        Math.max(0, valeurs.length - 1) + ' ligne(s))');
    }
  }

  // --- 2. flotte <- dts, puis tab vide ----------------------------------
  // Peuple si `flotte` est ABSENTE ou VIDE (en-tete seule) : un
  // redÃ©ploiement precedent a pu la creer vide avant la migration â€”
  // sans cette condition, la flotte resterait a jamais vide.
  const flotte = ss.getSheetByName(CONFIG.ONGLETS.FLOTTE);
  if (!flotte || flotte.getLastRow() <= 1) {
    const ancienDts = ss.getSheetByName(CONFIG.ONGLETS.TAB_LEGACY);
    if (ancienDts && ancienDts.getLastRow() > 1) {
      const lignes = ancienDts.getLastRow() > 1
        ? ancienDts.getDataRange().getValues().slice(1)
        : [];
      // Conversion du format historique : `type | id | actif`
      //   type   -> la FAMILLE (ex. `1500`, `785`, `ADT`, `EXCAVATOR`)
      //   id     -> le NUMERO de l'engin (ex. `1`, `2`, ...)
      // Le ROLE se deduit de la famille par l'ancienne regle: une famille
      // EXCAVATOR appartient a EXCAVATOR, le reste a DT. Les ajouts ulterieurs
      // de roles se feront directement dans l'onglet flotte.
      const rangees = [];
      for (const l of lignes) {
        const famille = String(l[0] || '').trim();
        const numero = String(l[1] || '').trim();
        if (!famille || !/^[0-9]+$/.test(numero)) continue;
        const role = famille.toUpperCase() === 'EXCAVATOR' ? 'EXCAVATOR' : 'DT';
        rangees.push([role, famille, numero, true]);
      }
      ecrireTableOuLoge(
        CONFIG.ONGLETS.FLOTTE, SCHEMAS.flotte, rangees,
        ['numero', 'famille']);
      faits.push('flotte <- dts (' + rangees.length + ' camion(s))');

      // Les anciennes lignes de `dts` n'etaient PAS des tablettes (c'etait
      // la flotte). `tab` demarre donc vide : il recevra les vraies
      // tablettes a la main.
      normaliserFlotte(ss, faits);
      const tab = ss.getSheetByName(CONFIG.ONGLETS.TAB);
      if (!tab) {
        const t = ss.insertSheet(CONFIG.ONGLETS.TAB);
        t.getRange(1, 1, 1, SCHEMAS.tab.length)
          .setValues([SCHEMAS.tab]).setFontWeight('bold');
        t.setFrozenRows(1);
        faits.push('tab cree (vide)');
      }
    }
  }

  // --- 3. equipements reserve -------------------------------------------
  // L'onglet `equipements` reste en place mais n'est plus lu pour le login.
  // On ne le recree pas s'il a ete supprime : `initialiser()` s'en charge
  // avec son nouveau schema (materiel).

  // L'onglet flotte EXISTANT est aussi normalise : colonne `role` ajoutee
  // si absente, roles remplis, ligne EXCAVATOR garantie — sans intervention
  // manuelle dans le Sheet (la SaaS commande, jamais l'operateur).
  normaliserFlotte(ss, faits);

  if (faits.length) {
    const rapport = 'STRUCTURATION : ' + faits.join(' | ');
    journal(rapport);
    if (verbeux) return rapport;
    return '';
  }
  if (verbeux) {
    return 'Rien a faire : <identifiants>, <flotte> et <tab> sont en place.';
  }
  return '';
}

/**
 * Normalise l'onglet `flotte` en place : garantit le schéma
 * `role | famille | numero | actif`, remplit les roles manquants et
 * assure la presence d'au moins une ligne EXCAVATOR. Idempotent, aucune
 * intervention manuelle dans le Sheet : c'est la SaaS qui commande.
 *
 * @param {Spreadsheet} ss classeur cible
 * @param {string[]} faits liste de compte-rendus à alimenter
 */
function normaliserFlotte(ss, faits) {
  let sh = ss.getSheetByName(CONFIG.ONGLETS.FLOTTE);
  if (!sh) return;

  // --- 1. Entête : garantir `role` en première colonne -------------------
  const entete = (sh.getLastColumn()
    ? sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0]
        .map((v) => String(v).trim())
    : []).filter((v) => v !== '');
  const attendu = SCHEMAS.flotte;
  let enteteModifiee = false;
  if (entete[0] !== 'role') {
    // Insertion de la colonne role en tête (les données suivent).
    sh.insertColumnBefore(1);
    entete.unshift('role');
    enteteModifiee = true;
  }
  // Complete les autres colonnes manquantes (famille, numero, actif).
  for (let i = 0; i < attendu.length; i++) {
    if (entete[i] !== attendu[i]) {
      if (entete.length <= i) entete.push(attendu[i]);
      else entete[i] = attendu[i];
      enteteModifiee = true;
    }
  }
  if (enteteModifiee) {
    sh.getRange(1, 1, 1, entete.length)
      .setValues([entete]).setFontWeight('bold');
    sh.setFrozenRows(1);
    faits.push('flotte : entête normalisée (' + entete.join(', ') + ')');
  }

  // --- 2. Données : lire, compléter les roles, réécrire ------------------
  const dernieres = sh.getLastRow();
  if (dernieres > 1) {
    const lignes = sh.getRange(2, 1, dernieres - 1, entete.length).getValues();
    let changes = 0;
    for (const l of lignes) {
      const famille = String(l[1] || '').trim();
      const numero = String(l[2] || '').trim();
      if (!famille || !numero) continue;
      const roleAvant = String(l[0] || '').trim().toUpperCase();
      if (roleAvant) continue;
      // Deduction par la famille (ancien format migré) : EXCAVATOR reste
      // EXCAVATOR, les familles numérotées (1500/785/ADD...) vont à DT.
      l[0] = famille.toUpperCase().includes('EXCAVATOR') ? 'EXCAVATOR' : 'DT';
      changes++;
    }
    if (changes) {
      sh.getRange(2, 1, lignes.length, entete.length).setValues(lignes);
      faits.push('flotte : ' + changes + ' role(s) complété(s)');
    }
  }

  // --- 3. Garantir une ligne EXCAVATOR -----------------------------------
  const rangeeExca = (dernieres > 1
    ? sh.getRange(2, 1, dernieres - 1, Math.max(2, entete.length)).getValues()
    : []).some((l) => String(l[0]).toUpperCase() === 'EXCAVATOR');
  if (!rangeeExca) {
    const ligne = ['EXCAVATOR', 'EXCAVATOR', '1', true]
      .slice(0, entete.length);
    while (ligne.length < entete.length) ligne.push('');
    sh.appendRow(ligne);
    faits.push('flotte : ligne EXCAVATOR ajoutée');
  }
}
