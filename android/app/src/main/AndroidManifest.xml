<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Requis pour telecharger les dalles de la carte de suivi (OpenStreetMap)
         et pour la synchro locale. Absent du manifest principal, l'APK de
         production n'aurait aucun reseau : les debug overlays ne suffisent pas. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Etat du reseau (4G / Wi-Fi).
         Sans cette permission, `connectivity_plus` ne peut pas interroger le
         systeme : il rend une liste vide ou partielle, et le badge 4G ne
         change jamais en cours d'execution. Permission normale, accordee a
         l'installation. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Route reseau forcee sur la 4G (voir RouteReseau.kt).
         `requestNetwork` + `bindProcessToNetwork` exigent cette permission :
         sans elle, ConnectivityService leve SecurityException, la route n'est
         jamais posee, et le trafic serveur reste bloque sur le point d'acces
         local (qui n'a pas d'Internet). Permission normale. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>

    <!-- Partage de connexion systeme (voir PartageConnexion.kt).
         Contrairement a `LocalOnlyHotspot`, il ne filtre pas le trafic
         entrant de l'hote : les clients peuvent joindre le serveur TCP de
         l'excavatrice. `TETHER_PRIVILEGED` est reserve aux apps systeme mais
         certains fabricants l'accordent ; a defaut, l'app retombe sur
         LocalOnlyHotspot. -->
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED"/>

    <!-- Alerte hors-parcours (echec de trajet) : vibration du device a
         chaque mesure GPS pendant l'alerte. Permission normale, accordee
         a l'installation. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Appareil photo : requis par le formulaire « Nouvelle ligne »
         (bouton Picture -> source « Appareil photo »). Sans cette
         declaration, `image_picker` leve une erreur et la camera ne
         s'ouvre jamais, meme apres autorisation runtime.
         `required="false"` : l'application reste installable sur un
         appareil sans camera (la galerie suffit alors). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Couche BLE TAB 3 <-> TAB 2 (CDC §7, §8, REQ-004/005/006/017) :
         decouverte BLE, connexion, RSSI pour le controle de proximite.
         La localisation fine est requise par Android < 12 pour scanner,
         ACCESS_BACKGROUND_LOCATION n'est pas necessaire : le scan ne tourne
         qu'au premier plan. -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Android >= 12 (API 31) : permissions BLE dediees, neverForLocation
         car nos balises ne portent aucune donnee de position. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Android >= 12 : requis pour le role peripherique (GATT server TAB 2,
         plugin ble_peripheral, advertise du service ORE TRACKING). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <!-- BLE obligatoire pour installer l'app sur les tablettes du parc. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <!-- Point d'acces Wi-Fi automatique cote excavatrice (profil excavator).
         Voie principale : WifiManager.startLocalOnlyHotspot(), API publique
         du framework depuis Android 8 — elle cree un reseau local SANS
         Internet, exactement ce dont l'excavatrice a besoin (c'est le DT qui
         porte la 4G). Elle exige NEARBY_WIFI_DEVICES sur Android 13+, et la
         localisation fine activee en dessous.
         Repli : Wi-Fi Direct (WifiP2pManager) si le hotspot est refuse.
         CHANGE_WIFI_STATE et ACCESS_WIFI_STATE couvrent l'etat de la radio. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false"/>

    <!-- XBee + GNSS u-blox sur cable USB-C (kit ArduSimple) : acces port serie
         via UsbManager natif. Permission normale, accordee a l'installation ;
         `required="false"` car une tablette du parc peut tourner en BLE ou en
         hotspot seul. Sans cette declaration, l'APK est installe mais
         usb_serial ne peut PAS ouvrir le device (SecurityException silencieuse
         du plugin : la couche XBee reste muette sans diagnostic net). -->
    <uses-permission android:name="android.permission.USB"/>
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

    <application
        android:label="ore_tracking"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Synthese vocale (flutter_tts) : depuis Android 11, interroger le
             moteur TTS du systeme exige cette declaration. Sans elle, la
             voix off reste muette sur les tablettes Android >= 30. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Appareil photo (image_picker, formulaire « Nouvelle ligne ») :
             Android 11+ filtre la resolution des activites. Sans cet intent,
             `pickImage(source: camera)` echoue avec "No Activity found"
             meme si la permission CAMERA est accordee. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
